;; (defcfg
  ;; linux-dev /dev/input/by-id/usb-AKKO_AKKO_3068BT-event-kbd
;; )


(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 500
  hold-time 200
)

(defalias
  ;; spanish accent layer trigger (tap = ', hold = accent layer)
  apos (tap-hold $tap-time $hold-time ' (layer-while-held spanish))

  ;; home row mods
  a (tap-hold $tap-time $hold-time a lmet)
  r (tap-hold $tap-time $hold-time r lalt)
  s (tap-hold $tap-time $hold-time s lsft)
  t (tap-hold $tap-time $hold-time t lctl)
  n (tap-hold $tap-time $hold-time n rctl)
  e (tap-hold $tap-time $hold-time e rsft)
  i (tap-hold $tap-time $hold-time i ralt)
  o (tap-hold $tap-time $hold-time o rmet)


  grl (tap-hold 200 200 esc (layer-toggle layers))
  mb_g (tap-hold $tap-time $hold-time g mmid)
  mr_s (tap-hold 100 100 s mrgt)
  gam2 (tap-hold 100 100 tab (layer-toggle gaming_layer_2))
  cap (tap-hold 200 200 caps lctl)

  vmov(layer-while-held vim_movement)
  npad(layer-while-held numpad)
  blr2(layer-while-held blender_layer_2)

  ;; layers
  blr1 (layer-switch blender_layer_1)
  col (layer-switch colemak)
  gam1 (layer-switch gaming_layer_1)
  drw (layer-switch drawing)
)


(defsrc
  esc   1     2     3     4     5     6     7     8     9     0     -     =     bspc  grv
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \     del
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret         pgup
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft        up    pgdn
  lctl  lmet  lalt              spc                     ralt        rctl  lft   down  rght
)


(deflayer colemak
  @grl  1     2     3     4     5     6     7     8     9     0     -     =     bspc  grv
  tab   q     w     f     p     b     k     l     u     y     ;     [     ]     \     del
  caps  @a    @r    @s    @t    g     m     @n    @e    @i    @o    @apos     ret         pgup
  @vmov z     x     c     d     v     j     h     ,     .     /     rsft        up    pgdn
  lctl  lmet  lalt              spc                     ralt        rctl  lft   down  rght
)


(deflayer layers
  _     @col  @blr1 @drw  @gam1 _     lrld  _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _           _
  _     _     _     _     _     _     _     _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)


(deflayer vim_movement
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     k     _     _     _     _     _     _
  _     _     _     _     _     _     _     h     j     l     _     _     _           _
  _     _     _     _     _     _     _     _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)


(deflayer blender_layer_1
  @grl  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     q     w     f     p     b     _     _     _     _     _     _     _
  _     _     _     a     @mb_g     s     r     t     _     @i     @o    _     _           _
  _     _     _     d     z     x     y     v     _     _     _     _           _     _
  _     _     @blr2             @npad                   _           _     _     _     _
)

(deflayer blender_layer_2
  @grl  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     k     l     u     y     ;     _     _     _     _     _     _     _
  _     _     _     m     n     e     i     o     _     _     @o    _     _           _
  _     _     _     j     h     ,     .     /     _     _     _     _           _     _
  _     _     _                 @npad                   _           _     _     _     _
)



(deflayer numpad
  _     _     _     _     1     2     3     _     _     _     _     _     _     _     _
  _     _     _     _     kp7   kp8   kp9   _     _     _     _     _     _     _     _
  _     _     _     kp0   kp4   kp5   kp6   _     _     _     _     _     _           _
  _     _     _     kp.   kp1   kp2   kp3   _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)


(deflayer gaming_layer_1
  @grl  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  t     y     q     w     e     r     t     _     _     _     _     _     _     _     _
  g     h     a     s     d     f     g     _     _     _     _     _     _           _
  b     n     z     x     c     v     b     _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)

(deflayer gaming_layer_2
  @grl  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     y     u     i     o     _     _     _     _     _     _     _     _     _
  _     _     h     j     k     l     _     _     _     _     _     _     _           _
  _     _     n     m     .     /     _     _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)





(deflayer drawing
  @grl  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     j     l     u     y     ;     _     _     _     _
  _     _     _     _     _     _     m     n     e     i     o     _     _           _
  _     _     _     _     _     _     k     h     ,     .     /     _           _     _
  _     _     _                 _                       _           _     _     _     _
)


(deflayer spanish
  _     _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     (fork (unicode ú) (unicode Ú) (lsft rsft))     _     _     _     _     _     _
  _     (fork (unicode á) (unicode Á) (lsft rsft))     _     _     _     _     _     (fork (unicode ñ) (unicode Ñ) (lsft rsft))     (fork (unicode é) (unicode É) (lsft rsft))     (fork (unicode í) (unicode Í) (lsft rsft))     (fork (unicode ó) (unicode Ó) (lsft rsft))     _     _           _
  _     _     _     _     _     _     _     _     _     _     _     _           _     _
  _     _     _                 _                       _           _     _     _     _
)


